# Application Port (defaults to 3000 locally; Cloud Run sets 8080 automatically)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Storage Mode (file | firestore)
# In development, defaults to 'file' (local data/todos.json).
# In production, defaults to 'firestore' (Google Cloud Firestore Native).
DATA_STORE=file

# Google Cloud Project Configuration (Required when DATA_STORE=firestore)
GOOGLE_CLOUD_PROJECT=taskly-prod-202611
GCP_PROJECT_ID=taskly-prod-202611
FIRESTORE_DATABASE_ID=(default)

# Optional: Custom local data file path override (useful for testing)
# TODO_DATA_FILE=./data/todos.json
