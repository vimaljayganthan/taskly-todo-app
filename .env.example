# ==============================================================================
# Taskly Environment Configuration Template
# ==============================================================================

# Application Port (defaults to 3000 locally; Cloud Run sets 8080 automatically)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Storage Mode (file | supabase | firestore)
# - In local development: defaults to 'file' (local data/todos.json)
# - On Vercel: automatically defaults to 'supabase'
# - On GCP Cloud Run: defaults to 'firestore'
DATA_STORE=file

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration (Required for Vercel Production)
# ------------------------------------------------------------------------------
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional: Service Role key for administrative scripts/migrations
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Google Cloud Platform (Only if deploying to GCP Cloud Run)
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=taskly-prod-202611
GCP_PROJECT_ID=taskly-prod-202611
FIRESTORE_DATABASE_ID=(default)

# Optional: Custom local data file path override
# TODO_DATA_FILE=./data/todos.json
