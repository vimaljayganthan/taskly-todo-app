# ==============================================================================
# Taskly Environment Configuration Template
# ==============================================================================

# Application Port (defaults to 3000 locally; Cloud Run sets 8080 automatically)
PORT=3000

# Environment Mode (development | production)
NODE_ENV=development

# Storage Mode (file | supabase | firestore)
# - In local development: defaults to 'file' (local data/todos.json)
# - On Vercel: automatically defaults to 'supabase'
# - On GCP Cloud Run: defaults to 'firestore'
DATA_STORE=file

# ------------------------------------------------------------------------------
# Local UI Preview Mode (Inspection without Supabase credentials)
# ------------------------------------------------------------------------------
# Strictly permitted ONLY when NODE_ENV is exactly 'development' and running on localhost.
# Must be explicitly set to 'true'. Automatically ignored and fails closed in production.
ENABLE_LOCAL_PREVIEW=true

# ------------------------------------------------------------------------------
# Canonical Application URL Configuration (Required for Email Confirmation)
# ------------------------------------------------------------------------------
# - Local development: defaults automatically to http://localhost:3000 (no setting needed).
# - Vercel Preview: automatically prioritized using deployment-specific VERCEL_URL.
# - Vercel Production: configure APP_URL to your canonical HTTPS domain.
#
# CRITICAL SECURITY REQUIREMENTS:
# - Deployed environments MUST use an absolute HTTPS URL (e.g. https://taskly.app).
# - NEVER configure localhost, 127.0.0.1, or non-HTTPS URLs in production.
# APP_URL=https://taskly-todo-app-4z1c.vercel.app

# ------------------------------------------------------------------------------
# Supabase PostgreSQL Configuration (Required for Vercel Production)
# ------------------------------------------------------------------------------
# Get these from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Optional: Service Role key for administrative scripts/migrations
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Supabase Authentication URL Configuration Allowlist Requirements:
# ------------------------------------------------------------------------------
# In Supabase Dashboard -> Authentication -> URL Configuration:
#
# 1. Site URL:
#    Set to your canonical production URL:
#    https://taskly-todo-app-4z1c.vercel.app
#
# 2. Redirect URLs (Allowlist):
#    Must allow browser confirmation page, Android native deep linking, local development, and deployed preview/production domains:
#    - https://taskly-todo-app-4z1c.vercel.app/auth/confirmed
#    - http://localhost:3000/auth/confirmed
#    - https://taskly-todo-app-4z1c.vercel.app/**
#    - http://localhost:3000/**
#    - http://localhost:3000
#    - com.taskly.app://auth/callback
#    - https://*-<team-slug>.vercel.app/** (covers branch previews)
#
# WARNING: Supabase rejects confirmation redirects if the target is not in this allowlist.

# ------------------------------------------------------------------------------
# Google Cloud Platform (Only if deploying to GCP Cloud Run)
# ------------------------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=taskly-prod-202611
GCP_PROJECT_ID=taskly-prod-202611
FIRESTORE_DATABASE_ID=(default)

# Optional: Custom local data file path override
# TODO_DATA_FILE=./data/todos.json
