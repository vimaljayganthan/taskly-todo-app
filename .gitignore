# Dependency directories
node_modules/
jspm_packages/

# Environment and sensitive configuration files
.env
.env.*
!.env.example
*.local

# Google Cloud credentials, Service Accounts, and Keys
*credentials*.json
*service-account*.json
*service_account*.json
client_secret*.json
*.pem
*.key
*.cert
*.p12
*.pfx
*.crt

# Runtime data and backups (server automatically seeds sample tasks if not present)
data/todos.json
data/*.backup.json
data/*.tmp
!data/.gitkeep

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Diagnostic and coverage outputs
coverage/
.nyc_output/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor directories
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# Build and production artifacts
dist/
build/
.cache/
.vercel/
scratch/

# Native mobile build outputs
.gradle/
*.apk
*.aab
android/app/release/
ios/App/build/
ios/App/*.xcworkspace/xcuserdata/
google-services.json
*taskly-notifications*.json

.vercel
.env*
